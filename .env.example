# Copia a .env.local en apps/web para desarrollo local.
# Nunca commitees valores reales (REQ-SEC-01).

APP_ENV=development
NODE_ENV=development

# URL pública de la app (dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos (opcional en dev local sin Postgres)
# DATABASE_URL=postgresql://user:pass@localhost:5432/telehealth

# Cifrado de datos de salud (obligatorio en staging/prod)
# ENCRYPTION_KEY=

# LiveKit (fase 2)
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Pagos: sandbox en staging, live en producción
PAYMENT_MODE=sandbox

# Auth.js (mín. 32 caracteres en staging/prod)
# AUTH_SECRET=

# Anthropic (solo servidor; en CI usar MOCK_CLAUDE=1)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514