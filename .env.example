# Copia a .env.local en apps/web para desarrollo local.
# Nunca commitees valores reales (REQ-SEC-01).

# development | staging | production (REQ-ARCH-03)
APP_ENV=development
NODE_ENV=development

# URL pública de la app (dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos (opcional en dev local sin Postgres)
# DATABASE_URL=postgresql://user:pass@localhost:5432/telehealth

# Cifrado de datos de salud (obligatorio en staging/prod)
# ENCRYPTION_KEY=

# LiveKit (Etapa 6)
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# MOCK_LIVEKIT=1
# MOCK_SETTLEMENTS=1
# ADMIN_SESSION_MAX_AGE_SEC=1200
# ADMIN_REQUIRE_MFA=0

# Pagos: sandbox en staging, live en producción
PAYMENT_MODE=sandbox

# Auth.js (mín. 32 caracteres en staging/prod)
# AUTH_SECRET=

# Anthropic (solo servidor; en CI usar MOCK_CLAUDE=1)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Staging (espejo de prod, REQ-QA-03) ---
# APP_ENV=staging
# NODE_ENV=production
# PAYMENT_MODE=sandbox
# NEXT_PUBLIC_APP_URL=https://staging.ejemplo.test
# DATABASE_URL=postgresql://...
# ENCRYPTION_KEY=...
# AUTH_SECRET=...
# Tras migrar: pnpm --filter @telehealth/db db:seed:anonymized