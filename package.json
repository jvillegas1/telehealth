{
  "name": "telehealth",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@telehealth/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e:launch": "pnpm --filter @telehealth/web exec playwright install chromium firefox webkit && pnpm --filter @telehealth/web test:e2e:launch",
    "db:create-admin": "pnpm --filter @telehealth/db db:create-admin",
    "db:up": "docker compose up -d",
    "db:setup": "docker compose up -d --wait && pnpm db:create-admin",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@eslint/js": "9.14.0",
    "eslint": "9.14.0",
    "globals": "15.12.0",
    "typescript-eslint": "8.14.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3"
  }
}
